{
	"name": "Black Money",
	"short_name": "Black Money",
	"description": "Track accounts, categories, transactions, and budget totals from one installable app.",
	"start_url": "/categories",
	"scope": "/",
	"display": "standalone",
	"background_color": "#C8FF3D",
	"theme_color": "#171717",
	"share_target": {
		"action": "/receipts/share",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "receipt",
					"accept": [
						"image/jpeg",
						"image/png",
						"image/webp",
						"image/heic",
						"image/heif",
						"application/pdf",
						".jpg",
						".jpeg",
						".png",
						".webp",
						".heic",
						".pdf"
					]
				}
			]
		}
	},
	"icons": [
		{
			"src": "/android-chrome-192x192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any maskable"
		},
		{
			"src": "/android-chrome-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any maskable"
		},
		{
			"src": "/apple-touch-icon.png",
			"sizes": "180x180",
			"type": "image/png"
		}
	]
}